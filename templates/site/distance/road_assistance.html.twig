{% extends 'site/components/_base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .road-hero {
            background: linear-gradient(135deg, var(--erm-primary) 0%, var(--erm-primary-dark) 100%);
        }
        .road-hero .hero-icon {
            width: 56px;
            height: 56px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, 0.15);
            border-radius: 16px;
        }
        .result-card {
            border: 1px solid #edf0f5;
            border-left: 4px solid #dee2e6;
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }
        .result-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.08) !important;
        }
        .result-card.result-card--best {
            border-left-color: #198754;
            background: linear-gradient(90deg, rgba(25, 135, 84, 0.05), transparent 40%);
        }
        .result-rank {
            width: 34px;
            height: 34px;
            min-width: 34px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            background: #e9ecef;
            color: #495057;
        }
        .result-card--best .result-rank {
            background: #198754;
            color: #fff;
        }
        .empty-state-icon {
            width: 84px;
            height: 84px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: var(--erm-primary-light);
            color: var(--erm-primary);
            font-size: 2rem;
        }
    </style>
{% endblock %}

{% block body %}

<div class="container-fluid my-4">

    <div class="row justify-content-center mb-4">
        <div class="col-12 col-xl-10">
            <div class="road-hero rounded-4 shadow-lg text-white p-4 p-md-5 d-flex align-items-center gap-4 flex-wrap flex-md-nowrap">
                <span class="hero-icon flex-shrink-0">
                    <i class="fas fa-road fa-lg"></i>
                </span>
                <div>
                    <h1 class="h3 mb-1 fw-bold">Dépanneur le plus proche</h1>
                    <p class="mb-0 opacity-75">Entrez une ville d'intervention pour trouver les centres les mieux placés pour un dépannage.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row justify-content-center g-4">
        <div class="col-12 {% if isSearchDone %}col-xl-5{% else %}col-lg-6{% endif %}">

            <div class="card shadow-sm border-0 rounded-4 p-4 mb-4">
                {{ form_start(formSearchByCity) }}
                    <div class="mb-4">
                        {{ form_label(formSearchByCity.city, 'Ville d\'intervention', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-light border-end-0"><i class="fas fa-map-marker-alt text-primary"></i></span>
                            {{ form_widget(formSearchByCity.city, {'attr': {'class': 'form-control border-start-0 ps-0', 'placeholder': 'Ex: Rennes, Lyon...'}}) }}
                        </div>
                    </div>
                    <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                        <button type="submit" class="btn btn-primary btn-lg px-4 rounded-3" id="submit-button">
                            <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                            <span class="button-text"><i class="fas fa-search me-2"></i>Rechercher</span>
                        </button>
                        <a href="{{ path('app_search_distance_for_road_assistance') }}" class="btn btn-outline-secondary btn-lg px-4 rounded-3"><i class="fas fa-undo me-2"></i>Réinitialiser</a>
                    </div>
                {{ form_end(formSearchByCity) }}
            </div>

            {% if isSearchDone %}
                {% if datas | length > 0 %}
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h2 class="h5 mb-0 fw-bold">
                            <i class="fas fa-list-ul me-2 text-primary"></i>{{ datas | length }} centre{{ datas | length > 1 ? 's' : '' }} trouvé{{ datas | length > 1 ? 's' : '' }}
                        </h2>
                        <span class="badge bg-soft-success rounded-pill px-3 py-2">
                            <i class="fas fa-sort-amount-down me-1"></i>Trié par distance
                        </span>
                    </div>

                    <div class="d-flex flex-column gap-2">
                        {% for data in datas %}
                            {% set dureeEnSecondes = data.duration %}
                            {% set hours = (dureeEnSecondes / 3600) | round(0, 'floor') %}
                            {% set minutes = (dureeEnSecondes / 60) % 60 | round(0, 'floor') %}
                            <div class="card result-card {% if loop.first %}result-card--best{% endif %} shadow-sm rounded-4">
                                <div class="card-body d-flex align-items-center gap-3 py-3">
                                    <span class="result-rank flex-shrink-0">{{ loop.index }}</span>
                                    <div class="flex-grow-1 min-width-0">
                                        <div class="d-flex align-items-center gap-2 flex-wrap">
                                            <span class="fw-bold text-truncate">{{ data.shop.name }}</span>
                                            <span class="badge bg-light text-muted border">{{ data.shop.cm }}</span>
                                            {% if loop.first %}
                                                <span class="badge bg-success rounded-pill"><i class="fas fa-star me-1"></i>Le plus proche</span>
                                            {% endif %}
                                        </div>
                                        <div class="d-flex align-items-center gap-3 mt-1 text-muted small flex-wrap">
                                            <span><i class="fas fa-route me-1 text-success"></i>{{ (data.distance / 1000) | round(1) }} km</span>
                                            <span>
                                                <i class="fas fa-clock me-1 text-info"></i>
                                                {% if hours > 0 %}{{ hours }} h {% endif %}{{ minutes }} min
                                            </span>
                                            {% if data.shop.phone %}
                                                <a href="tel:{{ data.shop.phone }}" class="text-decoration-none text-muted">
                                                    <i class="fas fa-phone me-1 text-primary"></i>{{ data.shop.phone }}
                                                </a>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="card border-0 shadow-sm rounded-4 text-center p-5">
                        <span class="empty-state-icon mx-auto mb-3"><i class="fas fa-map-marked-alt"></i></span>
                        <h3 class="h6 fw-bold mb-1">Aucun résultat</h3>
                        <p class="text-muted mb-0">Aucun centre ne correspond à cette recherche dans le rayon d'intervention.</p>
                    </div>
                {% endif %}
            {% else %}
                <div class="card border-0 shadow-sm rounded-4 text-center p-5">
                    <span class="empty-state-icon mx-auto mb-3"><i class="fas fa-road"></i></span>
                    <h3 class="h6 fw-bold mb-1">Prêt à chercher</h3>
                    <p class="text-muted mb-0">Choisissez une ville et un type de recherche pour lancer la recherche.</p>
                </div>
            {% endif %}
        </div>

        {% if isSearchDone %}
        <div class="col-12 col-xl-7">
            {% if datas | length > 0 %}
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-5">
                <div class="card-header bg-white border-0 py-3">
                    <h2 class="h6 mb-0 fw-bold"><i class="fas fa-map me-2 text-primary"></i>Carte des résultats</h2>
                </div>
                <div class="card-body p-0">
                    {{ ux_map(map, {'data-controller': 'mymap', 'controller_id': false, style: 'height: 650px;'}) }}
                </div>
            </div>
            {% endif %}
        </div>
        {% endif %}
    </div>
</div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.querySelector('form');
            const submitButton = document.getElementById('submit-button');

            if (form && submitButton) {
                form.addEventListener('submit', function(event) {
                    submitButton.querySelector('.spinner-border').classList.remove('d-none');
                    submitButton.querySelector('.button-text').classList.add('d-none');
                    submitButton.disabled = true;
                });
            }
        });
    </script>
{% endblock %}
