{% extends 'site/components/_base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block navbar %}
    {# Page vitrine publique : pas de menu réel (protégé par login) ni de contenu
       qui dépend de l'état de connexion du visiteur - juste une entête minimale
       et cohérente, que le lien soit ouvert anonymement ou par un utilisateur
       déjà connecté à l'application réelle. #}
    <nav class="navbar navbar-expand bg-primary shadow-sm" data-bs-theme="dark">
        <div class="container-fluid">
            <a class="navbar-brand fw-900" href="{{ path('app_demo_showcase') }}">ERM</a>
            <span class="badge bg-warning text-dark fw-bold ms-2"><i class="fas fa-flask me-1"></i>Démo publique</span>
        </div>
    </nav>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .demo-hero {
            background: linear-gradient(135deg, var(--erm-primary) 0%, var(--erm-primary-dark) 100%);
        }
        .demo-hero .hero-icon {
            width: 56px;
            height: 56px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, 0.15);
            border-radius: 16px;
        }
        .result-card {
            border: 1px solid #edf0f5;
            border-left: 4px solid #dee2e6;
        }
        .result-card.result-card--best {
            border-left-color: #198754;
            background: linear-gradient(90deg, rgba(25, 135, 84, 0.05), transparent 40%);
        }
        .result-rank {
            width: 34px;
            height: 34px;
            min-width: 34px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            background: #e9ecef;
            color: #495057;
        }
        .result-card--best .result-rank {
            background: #198754;
            color: #fff;
        }
    </style>
{% endblock %}

{% block body %}

<div class="container-fluid my-4">

    <div class="row justify-content-center mb-4">
        <div class="col-12 col-xl-10">
            <div class="demo-hero rounded-4 shadow-lg text-white p-4 p-md-5 d-flex align-items-center gap-4 flex-wrap flex-md-nowrap">
                <span class="hero-icon flex-shrink-0">
                    <i class="fas fa-eye fa-lg"></i>
                </span>
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                        <h1 class="h3 mb-0 fw-bold">Vitrine ERM Maps</h1>
                        <span class="badge bg-warning text-dark fw-bold"><i class="fas fa-flask me-1"></i>Démo - données fictives</span>
                    </div>
                    <p class="mb-0 opacity-75">Aperçu public du projet : carte interactive et recherche du centre le plus proche, avec un jeu de données inventé pour la démonstration (aucune donnée réelle client).</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row justify-content-center g-4">
        <div class="col-12 {% if results is not null %}col-xl-5{% else %}col-lg-6{% endif %}">

            <div class="card shadow-sm border-0 rounded-4 p-4 mb-4">
                <h2 class="h5 fw-bold mb-3"><i class="fas fa-search me-2 text-primary"></i>Trouver le centre le plus proche</h2>
                <form method="get">
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="ville">Ville de départ</label>
                        <select name="ville" id="ville" class="form-select form-select-lg">
                            <option value="">Choisir une ville...</option>
                            {% for city in searchCities %}
                                <option value="{{ city }}" {{ selectedCity == city ? 'selected' }}>{{ city }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg w-100 rounded-3">
                        <i class="fas fa-search me-2"></i>Rechercher
                    </button>
                </form>
            </div>

            {% if results is not null %}
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h2 class="h5 mb-0 fw-bold">
                        <i class="fas fa-list-ul me-2 text-primary"></i>{{ results|length }} centre{{ results|length > 1 ? 's' : '' }} trouvé{{ results|length > 1 ? 's' : '' }}
                    </h2>
                    <span class="badge bg-soft-success rounded-pill px-3 py-2">
                        <i class="fas fa-sort-amount-down me-1"></i>Trié par distance
                    </span>
                </div>

                <div class="d-flex flex-column gap-2">
                    {% for center in results %}
                        <div class="card result-card {% if loop.first %}result-card--best{% endif %} shadow-sm rounded-4">
                            <div class="card-body d-flex align-items-center gap-3 py-3">
                                <span class="result-rank flex-shrink-0">{{ loop.index }}</span>
                                <div class="flex-grow-1 min-width-0">
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <span class="fw-bold text-truncate">{{ center.name }}</span>
                                        <span class="badge bg-light text-muted border">{{ center.city }}</span>
                                        <span class="badge" style="background-color: {{ {'VI': '#0d6efd', 'VL': '#198754', 'MX': '#fd7e14'}[center.class] }}">{{ center.class }}</span>
                                        {% if loop.first %}
                                            <span class="badge bg-success rounded-pill"><i class="fas fa-star me-1"></i>Le plus proche</span>
                                        {% endif %}
                                    </div>
                                    <div class="d-flex align-items-center gap-3 mt-1 text-muted small">
                                        <span><i class="fas fa-route me-1 text-success"></i>{{ center.distance|round(1) }} km à vol d'oiseau</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <div class="col-12 {% if results is not null %}col-xl-7{% endif %}">
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-white border-0 py-3">
                    <h2 class="h6 mb-0 fw-bold"><i class="fas fa-map me-2 text-primary"></i>Carte des centres (démo)</h2>
                </div>
                <div class="card-body p-0">
                    {{ ux_map(map, {'data-controller': 'mymap', 'controller_id': false, style: 'height: 650px;'}) }}
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}
