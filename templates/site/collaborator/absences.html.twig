{% extends "site/components/_base.html.twig" %}

{% block title %}Saisie des Absences{% endblock %}

{% block body %}
<div class="container py-5">
    {# --- HEADER DE LA PAGE --- #}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-900 text-primary mb-0">ABSENCES</h1>
            <p class="text-muted fw-bold text-uppercase small">Enregistrement des congés et repos</p>
        </div>
        <div class="text-end">
            <i class="bi bi-calendar-check-fill fs-1 text-primary opacity-25"></i>
        </div>
    </div>

    {# --- SOUS-MENU DE NAVIGATION --- #}
    {% include "site/collaborator/_nav.html.twig" %}

    <div class="row g-4">
        
        {# COLONNE GAUCHE : FORMULAIRE DE SAISIE #}
        <div class="col-xl-4">
            <div class="card border-0 shadow-sm position-sticky" style="top: 20px;">
                <div class="card-header bg-white py-3 border-0">
                    <h5 class="mb-0 fw-bold text-dark">
                        <i class="bi bi-calendar-plus me-2 text-primary"></i>Nouvelle absence
                    </h5>
                </div>
                <div class="card-body">
                    {{ form_start(form) }}
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-uppercase opacity-75">Collaborateur</label>
                            {{ form_widget(form.collaborator, {'attr': {'class': 'form-select'}}) }}
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-uppercase opacity-75">Type de repos</label>
                            {{ form_widget(form.type, {'attr': {'class': 'form-select'}}) }}
                        </div>

                        <hr class="text-muted opacity-25 my-4">

                        <div class="row g-3">
                            <div class="col-6">
                                <label class="x-small fw-bold mb-1">Date de début</label>
                                {{ form_widget(form.startDate, {'attr': {'class': 'form-control'}}) }}
                            </div>
                            <div class="col-6">
                                <label class="x-small fw-bold mb-1">Date de fin</label>
                                {{ form_widget(form.endDate, {'attr': {'class': 'form-control'}}) }}
                            </div>
                        </div>

                        <div class="alert alert-info mt-4 border-0 small shadow-sm">
                            <i class="bi bi-info-circle-fill me-2"></i>
                            <strong>Règle de calcul :</strong><br>
                            - Dimanches exclus.<br>
                            - Samedis exclus pour JTT/RTT.<br>
                            - Samedis CP : max 5 / an.
                        </div>

                        <button type="submit" class="btn btn-primary w-100 mt-2 fw-bold py-2 shadow-sm">
                            <i class="bi bi-calendar-check me-2"></i>Valider l'absence
                        </button>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>

        {# COLONNE DROITE : HISTORIQUE DES ABSENCES #}
        <div class="col-xl-8">
            <div class="card border-0 shadow-sm overflow-hidden">
                <div class="card-header bg-white py-3 border-0">
                    <h5 class="mb-0 fw-bold text-dark">Historique des saisies</h5>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0 table-hover">
                        <thead class="bg-light">
                            <tr class="x-small text-muted text-uppercase">
                                <th class="ps-4 py-3">Collaborateur</th>
                                <th class="text-center">Type</th>
                                <th class="text-center">Période</th>
                                <th class="text-center">Jours déduits</th>
                                <th class="text-end pe-4">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for item in absences %}
                            {# Extraction des données du tableau associatif envoyé par le Controller #}
                            {% set a = item.data %}
                            {% set duration = item.realDuration %}

                            <tr>
                                <td class="ps-4">
                                    <span class="fw-bold d-block text-dark lh-1">
                                        {{ a.collaborator.firstName }} {{ a.collaborator.lastName|upper }}
                                    </span>
                                    <span class="text-muted x-small">Saisi le {{ a.createdAt|date('d/m/Y') }}</span>
                                </td>
                                <td class="text-center">
                                    {% set badgeClass = 'bg-soft-success text-success' %}
                                    {% if a.type == 'RTT' %}{% set badgeClass = 'bg-soft-warning text-warning' %}{% endif %}
                                    {% if a.type == 'JTT' %}{% set badgeClass = 'bg-soft-info text-info' %}{% endif %}
                                    
                                    <span class="badge {{ badgeClass }} px-3 py-2 rounded-pill fw-bold">
                                        {{ a.type }}
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="small fw-bold">
                                        Du {{ a.startDate|date('d/m') }} au {{ a.endDate|date('d/m/y') }}
                                    </div>
                                    <div class="x-small text-muted">
                                        {# Indicateur visuel si la période contient un dimanche #}
                                        {% if a.startDate|date('N') == 7 or a.endDate|date('N') == 7 %}
                                            <i class="bi bi-info-circle"></i> Dimanche ignoré
                                        {% endif %}
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="fs-5 fw-900 text-primary">{{ duration }}</span>
                                    <span class="small text-muted fw-bold"> j</span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a href="{{ path('app_collaborator_absence_edit', {'id': a.id}) }}" class="btn btn-sm btn-light rounded-circle">
                                            <i class="bi bi-pencil-square text-muted"></i>
                                        </a>
                                        <form method="post" action="{{ path('app_collaborator_absence_delete', {'id': a.id}) }}" onsubmit="return confirm('Supprimer cette absence ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ a.id) }}">
                                            <button class="btn btn-sm btn-outline-danger border-0 rounded-circle">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <div class="opacity-50">
                                        <i class="bi bi-calendar-x fs-1 d-block mb-3"></i>
                                        <p class="text-muted mb-0">Aucune absence enregistrée pour le moment.</p>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .fw-900 { font-weight: 900; }
    .x-small { font-size: 0.65rem; }
    
    .bg-soft-success { background-color: rgba(25, 135, 84, 0.1); }
    .bg-soft-warning { background-color: rgba(255, 193, 7, 0.15); }
    .bg-soft-info { background-color: rgba(13, 202, 240, 0.15); }

    .form-control, .form-select {
        border-radius: 8px;
        border: 1px solid #e2e8f0;
        padding: 0.5rem 0.75rem;
        font-size: 0.9rem;
    }

    .form-control:focus, .form-select:focus {
        border-color: #003399;
        box-shadow: 0 0 0 0.2rem rgba(0, 51, 153, 0.1);
    }

    .lh-1 { line-height: 1.2; }
</style>
{% endblock %}