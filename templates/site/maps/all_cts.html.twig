{% extends "site/components/_base.html.twig" %}

{% block title %}{{ title }}{% endblock %}

{% block body %}

<div class="container my-5">
    <h1 class="text-center mb-4"><i class="fas fa-user-tie me-2 text-primary"></i>{{ title }}</h1>

    <div class="row justify-content-center">
        <div class="col-12 col-xl-11">

            <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
                <div class="card-body p-0">
                    {% if mapDonnees is not empty %}
                        {{ ux_map(mapDonnees, {'data-controller': 'mymap', 'controller_id': false, style: 'height: 80vh; min-height: 500px; border-radius: 8px;' }) }}
                    {% else %}
                        <div class="alert alert-info text-center rounded-0 rounded-top m-0" role="alert">
                            <strong>Aucune donnée à afficher.</strong>
                        </div>
                    {% endif %}
                </div>
            </div>

            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body text-center">
                    <h5 class="card-title mb-3">Options d'affichage</h5>
                    <div class="nav-pill-group d-inline-flex">
                        <a href="{{ path('app_map_all_cts', {optionNameChoice: 'cts'}) }}" class="nav-pill-item {{ optionName == 'cts' ? 'active' }}">
                            <i class="fas fa-user-tie"></i>Afficher tous les CT
                        </a>
                        <a href="{{ path('app_map_all_cts', {optionNameChoice: 'shops'}) }}" class="nav-pill-item {{ optionName == 'shops' ? 'active' }}">
                            <i class="fas fa-store"></i>Afficher tous les centres
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}