<div class="map-popup">
    <div class="map-popup-header d-flex align-items-center gap-2 mb-2">
        <span class="avatar-circle bg-soft-primary flex-shrink-0"><i class="fas fa-store"></i></span>
        <div class="min-width-0">
            <h6 class="mb-0 fw-bold text-truncate">{{ shop.name }}</h6>
            <span class="badge bg-light text-muted border x-small">{{ shop.cm }}</span>
        </div>
    </div>

    <div class="d-flex gap-2 mb-2">
        <span class="badge bg-soft-success rounded-pill flex-fill py-2">
            <i class="fas fa-route me-1"></i>{{ (data.distance / 1000) | round(1) }} km
        </span>
        <span class="badge bg-soft-info rounded-pill flex-fill py-2">
            <i class="fas fa-clock me-1"></i>
            {% set dureeEnSecondes = data.duration %}
            {% set hours = (dureeEnSecondes / 3600) | round(0, 'floor') %}
            {% set minutes = (dureeEnSecondes / 60) % 60 | round(0, 'floor') %}
            {% if hours > 0 %}{{ hours }} h {% endif %}{{ minutes }} min
        </span>
    </div>

    {% if shop.phone %}
        <a href="tel:{{ shop.phone|replace({' ': ''}) }}" class="d-flex align-items-center gap-2 text-decoration-none text-muted small mb-2">
            <i class="fas fa-phone text-primary"></i>{{ shop.phone }}
        </a>
    {% endif %}

    <div class="map-popup-section">
        <h6 class="map-popup-section-title"><i class="fas fa-handshake me-1"></i>CGO(s)</h6>
        {% if shop.cgos is not empty %}
            <div class="d-flex flex-wrap gap-1">
                {% for cgo in shop.cgos %}
                    <span class="badge bg-light text-dark border x-small">{{ cgo.name }}</span>
                {% endfor %}
            </div>
        {% else %}
            <p class="text-muted fst-italic x-small mb-0">Aucun CGO rattaché</p>
        {% endif %}
    </div>

    <a href="https://www.google.com/maps/dir/?api=1&origin={{ cityOfIntervention.latitude }},{{ cityOfIntervention.longitude }}&destination={{ shop.city.latitude }},{{ shop.city.longitude }}" target="_blank" class="btn btn-primary btn-sm w-100 mt-2">
        <i class="fas fa-directions me-1"></i>Itinéraire
    </a>
</div>
