{% extends "site/components/_base.html.twig" %}

{% block title %}{{ title }}{% endblock %}

{% block body %}

<div class="container my-5">
    <h1 class="text-center mb-4"><i class="fas fa-store me-2 text-primary"></i>{{ title }}</h1>

    <div class="row justify-content-center">
        <div class="col-12 col-xl-11">
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="card-body p-0">
                    {% if mapDonnees is not empty %}
                        {{ ux_map(mapDonnees, {
                            'data-controller': 'mymap',
                            'controller_id': false,
                            style: 'height: 80vh; min-height: 500px; border-radius: 8px;'
                        }) }}
                    {% else %}
                        <div class="alert alert-info text-center rounded-0 rounded-top m-0" role="alert">
                            <strong>Aucune donnée à afficher.</strong>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}