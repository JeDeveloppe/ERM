{% extends "site/components/_base.html.twig" %}

{% block title %}Calendrier Planning RH{% endblock %}

{% block body %}
    {# --- TRADUCTION MANUELLE --- #}
    {% set moisFr = ['', 'Janvier', 'Février', 'Mars', 'Avril', 'Mai', 'Juin', 'Juillet', 'Août', 'Septembre', 'Octobre', 'Novembre', 'Décembre'] %}
    {% set joursFr = {'Mon': 'Lun', 'Tue': 'Mar', 'Wed': 'Mer', 'Thu': 'Jeu', 'Fri': 'Ven', 'Sat': 'Sam', 'Sun': 'Dim'} %}

    <div class="container-fluid py-5 px-4">
        {# --- EN-TÊTE --- #}
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="fw-900 text-primary mb-0">PILOTAGE RH</h1>
                <p class="text-muted fw-bold small text-uppercase mb-0">
                    Calendrier des absences —
                    {{ moisFr[currentMonth|date('n')] }}
                    {{ currentMonth|date('Y') }}
                </p>
            </div>

            <div class="d-flex align-items-center gap-3">
                <div class="d-inline-flex gap-2 align-items-center bg-white p-1 rounded-pill shadow-sm border">
                    <a href="{{ path('app_collaborator_calendar_index', {month: prevMonth|date('m'), year: prevMonth|date('Y')}) }}" class="btn btn-light btn-sm rounded-circle">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                    <span class="px-2 fw-bold text-uppercase x-small" style="min-width: 120px; text-align: center;">
                        {{ moisFr[currentMonth|date('n')] }}
                        {{ currentMonth|date('Y') }}
                    </span>
                    <a href="{{ path('app_collaborator_calendar_index', {month: nextMonth|date('m'), year: nextMonth|date('Y')}) }}" class="btn btn-light btn-sm rounded-circle">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </div>
            </div>
        </div>

        {% include "site/collaborator/_nav.html.twig" %}

        {% if collaborators is empty %}
            <div class="card border-0 shadow-sm rounded-4 py-5 mt-4">
                <div class="card-body text-center py-5">
                    <div class="empty-state-container mb-4 mx-auto">
                        <div class="main-icon-circle shadow-sm bg-soft-warning">
                            <i class="bi bi-people text-warning"></i>
                        </div>
                    </div>
                    <h2 class="fw-900 text-dark mb-2">Le calendrier est vide</h2>
                    <a href="{{ path('app_collaborator_index') }}" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm">Ajouter des collaborateurs</a>
                </div>
            </div>
        {% else %}
            {# --- GRILLE CALENDRIER VERTICALE --- #}
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4 mt-4">
                <div class="table-responsive calendar-container" style="max-height: 800px;">
                    <table class="table table-bordered mb-0">
                        <thead>
                            <tr class="bg-light align-middle text-center sticky-top-row">
                                <th class="sticky-col-header date-col border-bottom-0">Date</th>
                                {% for collab in collaborators %}
                                    <th class="collab-col border-bottom-0">
                                        <div class="d-flex flex-column align-items-center p-2">
                                            <div class="avatar-sm-sq mb-1 bg-primary-gradient text-white">{{ collab.firstName|first|upper }}</div>
                                            <span class="x-small fw-bold text-truncate" style="max-width: 100px;">{{ collab.firstName }}
                                                {{ collab.lastName|upper }}</span>
                                            <span class="badge {{ collab.saturdaysTaken >= 5 ? 'bg-danger' : 'bg-soft-indigo text-indigo' }} rounded-pill xx-small mt-1">
                                                S: {{ collab.saturdaysTaken }}/5
                                            </span>
                                        </div>
                                    </th>
                                {% endfor %}
                            </tr>
                        </thead>
                        <tbody>
                            {% for day in daysInMonth %}
                                {% set currentDayStr = day|date('Y-m-d') %}
                                {% set isWeekend = day|date('N') >= 6 %}
                                {% set isSunday = day|date('N') == 7 %}
                                {% set isHoliday = currentDayStr in holidays %}
                                {% set dayName = day|date('D') %}

                                <tr class="{{ isWeekend ? 'bg-weekend-row' : '' }} {{ isHoliday ? 'bg-holiday-row' : '' }}">
                                    {# Colonne Date Fixe #}
                                    <td class="sticky-col date-cell fw-bold border-end text-center
                                        {{ isHoliday ? 'bg-holiday' : (isSunday ? 'bg-sunday' : (day|date('N') == 6 ? 'bg-saturday' : 'bg-white')) }}">
                                        <span class="x-small text-muted text-uppercase d-block lh-1">{{ joursFr[dayName] }}</span>
                                        <span class="fs-6 {{ isHoliday ? 'text-danger' : (isWeekend ? 'text-primary' : 'text-dark') }}">
                                            {{ day|date('d') }}
                                        </span>
                                        {% if isHoliday %}
                                            <span class="d-block xx-small text-danger fw-bold text-uppercase">Férié</span>
                                        {% endif %}
                                    </td>

                                    {# Colonnes Collaborateurs #}
                                    {% for collab in collaborators %}
                                        {% set dayAbsence = null %}
                                        {% for abs in absences %}
                                            {% if abs.collaborator.id == collab.id and currentDayStr >= abs.startDate|date('Y-m-d') and currentDayStr <= abs.endDate|date('Y-m-d') %}
                                                {% set dayAbsence = abs %}
                                            {% endif %}
                                        {% endfor %}

                                        <td class="p-0 day-cell-vertical {{ isHoliday ? 'bg-holiday' : (isSunday ? 'bg-sunday' : (day|date('N') == 6 ? 'bg-saturday' : '')) }}">
                                            {# Rendu de l'absence uniquement si ce n'est NI un dimanche NI un jour férié #}
                                            {% if dayAbsence and not isHoliday and not isSunday %}
                                                <div class="absence-segment-vertical absence-{{ dayAbsence.type|lower }}" 
                                                     data-bs-toggle="tooltip" 
                                                     title="{{ dayAbsence.type }} : {{ collab.firstName }}">
                                                </div>
                                            {% endif %}
                                        </td>
                                    {% endfor %}
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            {# --- LÉGENDE --- #}
            <div class="d-flex gap-4 justify-content-center bg-white py-3 rounded-pill shadow-sm border mx-auto" style="max-width: 850px;">
                <div class="d-flex align-items-center">
                    <span class="legend-dot bg-cp"></span>
                    <small class="fw-bold ms-2 text-muted x-small text-uppercase">CP</small>
                </div>
                <div class="d-flex align-items-center">
                    <span class="legend-dot bg-rtt"></span>
                    <small class="fw-bold ms-2 text-muted x-small text-uppercase">RTT</small>
                </div>
                <div class="d-flex align-items-center">
                    <span class="legend-dot bg-jtt"></span>
                    <small class="fw-bold ms-2 text-muted x-small text-uppercase">JTT</small>
                </div>
                <div class="d-flex align-items-center">
                    <span class="legend-dot bg-holiday border border-danger"></span>
                    <small class="fw-bold ms-2 text-danger x-small text-uppercase">Férié / Dimanche</small>
                </div>
            </div>
        {% endif %}
    </div>

    <style>
        body { background-color: #f4f7fe; font-family: 'Plus Jakarta Sans', sans-serif; }
        .fw-900 { font-weight: 900; }
        .x-small { font-size: 0.75rem; }
        .xx-small { font-size: 0.6rem; }

        .sticky-top-row th { position: sticky; top: 0; z-index: 10; background: #f8f9fa; box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05); }
        .sticky-col { position: sticky; left: 0; z-index: 5; min-width: 80px; box-shadow: 2px 0 5px rgba(0, 0, 0, 0.02); }
        .sticky-col-header { position: sticky; left: 0; top: 0; z-index: 15 !important; background: #f8f9fa !important; }

        .collab-col { min-width: 120px; }
        .day-cell-vertical { height: 40px; vertical-align: middle; border-color: #e2e8f0 !important; }

        .bg-saturday { background-color: #f8faff !important; }
        .bg-sunday { background-color: #f1f4ff !important; }
        .bg-holiday { background-color: #fff1f2 !important; }
        .bg-weekend-row { background-color: #edf2ff33; }
        .bg-holiday-row { border-top: 1px solid #fee2e2 !important; border-bottom: 1px solid #fee2e2 !important; }

        .avatar-sm-sq { width: 28px; height: 28px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 0.7rem; font-weight: 800; }
        .bg-primary-gradient { background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); }
        .bg-soft-indigo { background-color: #e0e7ff; color: #4338ca; }

        .absence-segment-vertical { height: 100%; width: 100%; min-height: 38px; transition: opacity 0.2s; cursor: pointer; }
        .absence-segment-vertical:hover { opacity: 0.8; }

        .absence-cp, .bg-cp { background-color: #4ade80 !important; }
        .absence-rtt, .bg-rtt { background-color: #38bdf8 !important; }
        .absence-jtt, .bg-jtt { background-color: #fb7185 !important; }

        .legend-dot { width: 12px; height: 12px; border-radius: 4px; }
        .calendar-container::-webkit-scrollbar { width: 8px; height: 8px; }
        .calendar-container::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
    </style>
{% endblock %}