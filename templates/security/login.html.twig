{% extends 'site/components/_base.html.twig' %}

{% block title %}Se connecter{% endblock %}

{% block body %}

    <div class="row g-0 justify-content-center align-items-center py-5" style="min-height: 70vh;">
        <div class="col-11 col-sm-8 col-md-5 text-center mb-4 mb-md-0">
            <img src="{{ asset('images/logo.png') }}" alt="Logo ErmMaps" class="img-fluid" style="max-height: 220px;">
        </div>
        <div class="col-11 col-sm-8 col-md-5">
            <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5">
                <div class="text-center mb-4">
                    <span class="bg-soft-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 56px; height: 56px;">
                        <i class="fas fa-lock text-primary"></i>
                    </span>
                    <h1 class="h4 fw-900 mb-1">Connexion</h1>
                    <p class="text-muted small mb-0">Accédez à ERM Maps</p>
                </div>
                {% include "site/components/_login_form.html.twig" %}
            </div>
        </div>
    </div>

{% endblock %}
